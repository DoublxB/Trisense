# --- Plată --- AI Studio GEMINI_API_KEY e separată de GCP. Cu trial-ul Cloud folosești
# Vertex + Neural2 TTS: cheie_google.json + (opțional) TRISENSE_TTS_PCM_SOURCE=google_cloud .
# NU pune GEMINI_API_KEY dacă nu vrei billing AI Studio; lasă Gemini doar via Vertex (= facturabil pe proiectul GCP cu credite trial).
GEMINI_USE_VERTEX=1
# Regiune: Gemini 3.x preview necesită de obicei `global`; alte modele pot folosi europe-west4.
GCP_LOCATION=global
# Opțional (altfel citește project_id din cheie_google.json):
# GCP_PROJECT=my-gcp-project
# Gemini 3.1 Flash preview pe Vertex — dacă 404 pentru proiectul tău, schimbă:
# GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.1-flash-lite
# Opțional: cale explicită la JSON (în loc sau în plus față de ./cheie_google.json)
# GOOGLE_APPLICATION_CREDENTIALS=C:\\Users\\YOU\\Desktop\\Licenta mea\\cheie_google.json

# --- Opție: Google AI Studio (fără Vertex) ---
# Preferi Gemini prin AI Studio (GEMINI_API_KEY) în loc de Vertex chiar dacă există cheie_google.json?
# GEMINI_USE_VERTEX=0
# GEMINI_API_KEY=your-gemini-api-key-here

# pcm edge_tts | gemini | google_cloud
# edge_tts = principal (voce română Microsoft online), cu fallback la Cloud/Gemini.
TRISENSE_TTS_PCM_SOURCE=edge_tts
GCP_TTS_VOICE=ro-RO-Neural2-A
GCP_TTS_LANGUAGE=ro-RO
GCP_TTS_SAMPLE_RATE_HZ=24000
TRISENSE_TTS_PCM_ALLOW_GEMINI_FALLBACK=1

# PCM sintetizat pe PC către ESP (dacă folosești difuzorul prin TCP)
# TRISENSE_TTS_OVER_TCP=1

# LAN: IPv4 laptop din ipconfig (aceeași rețea ca ESP).
MQTT_BROKER=192.168.x.x
MQTT_PORT=1883
MQTT_CLIENT_ID_PC=TriSense_PC_Brain_3

# --- Rețea: PC vs robot (nu amesteca) ---
# Laptop (ipconfig) — ESP folosește acest IP pentru TCP voce și Mosquitto.
PC_VOICE_IP=192.168.x.x
VOICE_TCP_PORT=8765

# Placa ESP — IP afișat pe serial după Wi‑Fi. După schimbarea rețelei, actualizează.
# ROBOT_ESP_IP=172.20.10.xx
TRISENSE_TTS_OVER_TCP=1
# ESP_AUDIO_TCP_PORT=8766
# GEMINI_TRANSCRIBE_MODEL=gemini-3.1-flash-preview

# OPTIONAL: HuskyLens
# VISION_ID_TO_ACTION={"21":"dance","22":"breathe_in"}

# --- ESP32-CAM (firmware TriSense HTTP: /capture port 80, stream :81) ---
# Rulezi pe PC: py testare/vision_esp32cam_bridge.py (Vertex analizeaza JPEG si publica vision/tags).
# ESP32CAM_CAPTURE_URL=http://192.168.x.x/capture
# ESP32CAM_HOST=192.168.x.x
# VISION_CAM_INTERVAL_SEC=3
# VISION_CAM_PUBLISH_MODE=change_only
# every = publica la fiecare ciclu chiar daca id-ul e la fel (uneori util pentru brain).
# VISION_CAM_PUBLISH_MODE=every
# Prompt JSON {"id":N} — aliniaza cu clasele Husky / VISION_ID_TO_ACTION din brain.
# VISION_CAM_PROMPT=
# ESP32CAM_MQTT_CLIENT_ID=TriSense_ESP32CAM_Bridge
